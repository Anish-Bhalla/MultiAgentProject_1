# Copy to .env. All fields below are optional for local demo mode.
# If OPENAI_API_KEY is blank, planner, SQL generation and synthesis use deterministic fallbacks.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
LLM_ENABLED=true

# Free local baseline: BM25 lexical retrieval. Optional dense/hybrid needs requirements-dense.txt.
RAG_RETRIEVAL_MODE=bm25
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=180
RAG_TOP_K=5

# Optional external search API. If blank, the MCP tool tries the DDGS free web-search package.
BRAVE_SEARCH_API_KEY=

LOG_LEVEL=INFO
MAX_SQL_ROWS=200
SQL_TIMEOUT_SECONDS=2
WEB_TIMEOUT_SECONDS=12
